#!/bin/sh
# Mac launcher: use this instead of `python` (macOS has python3, not python).
#   ./pral                         web UI
#   ./pral desktop                 native window
#   ./pral food banana             CLI
set -e
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [ -f "venv/bin/activate" ]; then
    # shellcheck disable=SC1091
    . "venv/bin/activate"
elif [ -f ".venv/bin/activate" ]; then
    # shellcheck disable=SC1091
    . ".venv/bin/activate"
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "This Mac has no python3 — that is why \`python\` also failed."
    echo ""
    echo "Fix (pick one):"
    echo "  1. Double-click: 1. Setup Presentation Generator"
    echo "  2. Install Apple's tools:  xcode-select --install"
    echo "  3. Install Python 3 from https://www.python.org/downloads/"
    exit 1
fi

if [ $# -eq 0 ] || [ "$1" = "ui" ]; then
    exec python3 pral_ui.py
fi
if [ "$1" = "desktop" ]; then
    exec python3 desktop_pral.py
fi
exec python3 pral.py "$@"
